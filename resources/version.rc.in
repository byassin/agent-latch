#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.manifest"
IDI_AGENTLATCH ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"

IDD_MANUAL_HOURS DIALOGEX 0, 0, 230, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keep awake for a set time"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Hours (1 to 168):", -1, 12, 14, 112, 14
    EDITTEXT IDC_MANUAL_HOURS, 132, 12, 84, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Agent monitoring continues when the timer ends.", -1, 12, 39, 204, 23
    DEFPUSHBUTTON "Start", IDOK, 104, 77, 54, 17
    PUSHBUTTON "Cancel", IDCANCEL, 164, 77, 54, 17
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AgentLatch contributors\0"
            VALUE "FileDescription", "Agent-aware wake manager for Windows\0"
            VALUE "FileVersion", "@AGENTLATCH_VERSION_LABEL@\0"
            VALUE "InternalName", "AgentLatch\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 AgentLatch contributors\0"
            VALUE "OriginalFilename", "AgentLatch.exe\0"
            VALUE "ProductName", "AgentLatch\0"
            VALUE "ProductVersion", "@AGENTLATCH_VERSION_LABEL@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
